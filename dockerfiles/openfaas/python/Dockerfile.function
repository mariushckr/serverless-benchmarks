ARG BASE_IMAGE
FROM $BASE_IMAGE
ARG VERSION
ENV PYTHON_VERSION=${VERSION}
COPY . function/

RUN if [ ! -f "function/__init__.py" ]; then touch function/__init__.py; fi \
	&& if test -f "function/requirements.txt.${PYTHON_VERSION}"; then pip install --no-cache-dir -r function/requirements.txt.${PYTHON_VERSION} function/ ; else pip install --no-cache-dir -r function/requirements.txt function/ ; fi

RUN echo "from .function import handler" > function/__init__.py

# Simple entrypoint: run __main__.py which should implement HTTP handling
CMD ["python3", "-m", "function"]
